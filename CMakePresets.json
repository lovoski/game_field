{
  "version": 3,
  "configurePresets": [
    {
      "name": "build_win",
      "binaryDir": "${sourceDir}/build_win",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "build_win_manga_viewer",
      "inherits": "build_win",
      "binaryDir": "${sourceDir}/build_win_manga_viewer",
      "cacheVariables": {
        "TOOLKIT_ENABLE_CNPY": "OFF",
        "MUPDF_ROOT": "D:/repo/mupdf"
      }
    },
    {
      "name": "build_linux_dbg",
      "binaryDir": "${sourceDir}/build_linux",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build_win_dbg",
      "configurePreset": "build_win",
      "configuration": "Debug"
    },
    {
      "name": "build_win_rel",
      "configurePreset": "build_win",
      "configuration": "Release"
    },
    {
      "name": "build_win_manga_viewer_dbg",
      "configurePreset": "build_win_manga_viewer",
      "configuration": "Debug",
      "targets": [
        "manga_viewer"
      ]
    },
    {
      "name": "build_win_manga_viewer_rel",
      "configurePreset": "build_win_manga_viewer",
      "configuration": "Release",
      "targets": [
        "manga_viewer"
      ]
    },
    {
      "name": "build_linux_dbg",
      "configurePreset": "build_linux_dbg"
    },
    {
      "name": "build_win_manga",
      "description": "",
      "displayName": "",
      "inherits": [
        "build_win_manga_viewer_dbg",
        "build_win_manga_viewer_rel"
      ]
    }
  ]
}